rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'govind7340463311@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'plan', 'preferredLanguage', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'plan', 'preferredLanguage', 'theme', 'charactersCount', 'projectsCount', 'videosCount', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role in ['creator', 'admin']
        && data.plan in ['free', 'pro', 'studio']
        && data.preferredLanguage in ['en', 'hi']
        && data.theme in ['light', 'dark']
        && (!('charactersCount' in data) || (data.charactersCount is int && data.charactersCount >= 0))
        && (!('projectsCount' in data) || (data.projectsCount is int && data.projectsCount >= 0))
        && (!('videosCount' in data) || (data.videosCount is int && data.videosCount >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCharacter(data, charId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'style', 'voiceStyle', 'voiceName', 'cartoonImageUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'style', 'voiceStyle', 'voiceName', 'personality', 'facialTraits', 'sourceImageUrl', 'cartoonImageUrl', 'accentColor', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == charId && isValidId(data.id)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.style in ['3d', 'pixar', 'anime', 'comic']
        && data.voiceStyle in ['male', 'female', 'child', 'narrator']
        && data.voiceName in ['Puck', 'Charon', 'Kore', 'Fenrir', 'Zephyr']
        && (!('personality' in data) || (data.personality is string && data.personality.size() <= 300))
        && (!('facialTraits' in data) || (data.facialTraits is string && data.facialTraits.size() <= 1000))
        && (!('sourceImageUrl' in data) || (data.sourceImageUrl is string && data.sourceImageUrl.size() <= 500))
        && data.cartoonImageUrl is string && data.cartoonImageUrl.size() >= 1 && data.cartoonImageUrl.size() <= 500
        && (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'language', 'genre', 'durationMinutes', 'aspectRatio', 'quality', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'titleHindi', 'moralOrSummary', 'language', 'genre', 'durationMinutes', 'aspectRatio', 'quality', 'status', 'bgmMood', 'bgmAudioUrl', 'musicVolume', 'voiceVolume', 'sceneCount', 'characterIds', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == projectId && isValidId(data.id)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && (!('titleHindi' in data) || (data.titleHindi is string && data.titleHindi.size() <= 160))
        && (!('moralOrSummary' in data) || (data.moralOrSummary is string && data.moralOrSummary.size() <= 600))
        && data.language in ['hi', 'en']
        && data.genre in ['comedy', 'family', 'adventure', 'education', 'mystery', 'moral']
        && data.durationMinutes in [1, 3, 5, 10]
        && data.aspectRatio in ['16:9', '9:16']
        && data.quality in ['720p', '1080p']
        && data.status in ['draft', 'scripted', 'voiced', 'animated', 'exported']
        && (!('bgmMood' in data) || (data.bgmMood is string && data.bgmMood.size() <= 120))
        && (!('bgmAudioUrl' in data) || (data.bgmAudioUrl is string && data.bgmAudioUrl.size() <= 500))
        && (!('musicVolume' in data) || (data.musicVolume is number && data.musicVolume >= 0 && data.musicVolume <= 1))
        && (!('voiceVolume' in data) || (data.voiceVolume is number && data.voiceVolume >= 0 && data.voiceVolume <= 1))
        && (!('sceneCount' in data) || (data.sceneCount is int && data.sceneCount >= 0 && data.sceneCount <= 50))
        && (!('characterIds' in data) || (data.characterIds is list && data.characterIds.size() <= 10 && (data.characterIds.size() == 0 || data.characterIds[0] is string)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScene(data, projectId, sceneId) {
      return data.keys().hasAll(['id', 'projectId', 'ownerId', 'orderIndex', 'act', 'title', 'dialogueHindi', 'dialogueEnglish', 'durationSec', 'animationStatus', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'ownerId', 'orderIndex', 'act', 'title', 'visualPrompt', 'cameraMovement', 'transition', 'backgroundMood', 'characterName', 'characterId', 'speakerVoiceStyle', 'voiceName', 'dialogueHindi', 'dialogueEnglish', 'durationSec', 'frameImageUrl', 'audioUrl', 'videoUrl', 'animationStatus', 'updatedAt'])
        && data.id is string && data.id == sceneId && isValidId(data.id)
        && data.projectId is string && data.projectId == projectId && isValidId(data.projectId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 50
        && data.act in ['beginning', 'middle', 'climax', 'ending']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && (!('visualPrompt' in data) || (data.visualPrompt is string && data.visualPrompt.size() <= 1000))
        && (!('cameraMovement' in data) || (data.cameraMovement is string && data.cameraMovement.size() <= 60))
        && (!('transition' in data) || (data.transition is string && data.transition.size() <= 40))
        && (!('backgroundMood' in data) || (data.backgroundMood is string && data.backgroundMood.size() <= 60))
        && (!('characterName' in data) || (data.characterName is string && data.characterName.size() <= 80))
        && (!('characterId' in data) || (data.characterId is string && data.characterId.size() <= 128))
        && (!('speakerVoiceStyle' in data) || (data.speakerVoiceStyle in ['male', 'female', 'child', 'narrator']))
        && (!('voiceName' in data) || (data.voiceName in ['Puck', 'Charon', 'Kore', 'Fenrir', 'Zephyr']))
        && data.dialogueHindi is string && data.dialogueHindi.size() <= 1000
        && data.dialogueEnglish is string && data.dialogueEnglish.size() <= 1000
        && data.durationSec is number && data.durationSec >= 1 && data.durationSec <= 120
        && (!('frameImageUrl' in data) || (data.frameImageUrl is string && data.frameImageUrl.size() <= 500))
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 500))
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500))
        && data.animationStatus in ['pending', 'ready', 'ai_video', 'error']
        && data.updatedAt is timestamp;
    }

    function isValidVideo(data, videoId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'title', 'aspectRatio', 'quality', 'durationSec', 'downloadUrl', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'projectId', 'title', 'language', 'aspectRatio', 'quality', 'durationSec', 'fileSizeBytes', 'format', 'downloadUrl', 'thumbnailUrl', 'createdAt'])
        && data.id is string && data.id == videoId && isValidId(data.id)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && (!('language' in data) || (data.language in ['hi', 'en']))
        && data.aspectRatio in ['16:9', '9:16']
        && data.quality in ['720p', '1080p']
        && data.durationSec is number && data.durationSec >= 1 && data.durationSec <= 1200
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is int && data.fileSizeBytes >= 0))
        && (!('format' in data) || (data.format is string && data.format.size() <= 20))
        && data.downloadUrl is string && data.downloadUrl.size() >= 1 && data.downloadUrl.size() <= 500
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidUsageLog(data, logId) {
      return data.keys().hasAll(['id', 'ownerId', 'feature', 'model', 'status', 'durationMs', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'userEmail', 'feature', 'model', 'status', 'durationMs', 'errorMessage', 'createdAt'])
        && data.id is string && data.id == logId && isValidId(data.id)
        && data.ownerId is string && isValidId(data.ownerId)
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 200))
        && data.feature in ['character', 'story', 'tts', 'animation', 'music', 'export']
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 100
        && data.status in ['success', 'error']
        && data.durationMs is int && data.durationMs >= 0
        && (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidTemplate(data, templateId) {
      return data.keys().hasAll(['id', 'title', 'genre', 'language', 'prompt', 'active', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'genre', 'language', 'prompt', 'active', 'updatedAt'])
        && data.id is string && data.id == templateId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.genre in ['comedy', 'family', 'adventure', 'education', 'mystery', 'moral']
        && data.language in ['hi', 'en']
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 600
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerified()
        && request.auth.uid == userId
        && isValidUser(incoming(), userId)
        && incoming().role == 'creator'
        && incoming().plan == 'free'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            request.auth.uid == userId
            && incoming().role == existing().role
            && incoming().plan == existing().plan
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredLanguage', 'theme', 'charactersCount', 'projectsCount', 'videosCount', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /characters/{characterId} {
      allow get: if isValidId(characterId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(characterId)
        && isVerified()
        && isValidCharacter(incoming(), characterId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(characterId)
        && isVerified()
        && isValidCharacter(incoming(), characterId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'style', 'voiceStyle', 'voiceName', 'personality', 'facialTraits', 'cartoonImageUrl', 'accentColor', 'updatedAt'])
          )
        );
      allow delete: if isValidId(characterId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(projectId)
        && isVerified()
        && isValidProject(incoming(), projectId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isVerified()
        && isValidProject(incoming(), projectId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'titleHindi', 'moralOrSummary', 'aspectRatio', 'quality', 'status', 'bgmMood', 'bgmAudioUrl', 'musicVolume', 'voiceVolume', 'sceneCount', 'characterIds', 'updatedAt'])
          )
        );
      allow delete: if isValidId(projectId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());

      match /scenes/{sceneId} {
        allow get: if isValidId(projectId) && isValidId(sceneId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isValidId(projectId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isValidId(projectId)
          && isValidId(sceneId)
          && isVerified()
          && isValidScene(incoming(), projectId, sceneId)
          && incoming().ownerId == request.auth.uid
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(projectId)
          && isValidId(sceneId)
          && isVerified()
          && isValidScene(incoming(), projectId, sceneId)
          && incoming().ownerId == existing().ownerId
          && incoming().projectId == existing().projectId
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              existing().ownerId == request.auth.uid
              && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['orderIndex', 'act', 'title', 'visualPrompt', 'cameraMovement', 'transition', 'backgroundMood', 'characterName', 'characterId', 'speakerVoiceStyle', 'voiceName', 'dialogueHindi', 'dialogueEnglish', 'durationSec', 'frameImageUrl', 'audioUrl', 'videoUrl', 'animationStatus', 'updatedAt'])
            )
          );
        allow delete: if isValidId(projectId) && isValidId(sceneId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
      }
    }

    match /videos/{videoId} {
      allow get: if isValidId(videoId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(videoId)
        && isVerified()
        && isValidVideo(incoming(), videoId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(videoId) && isAdmin() && isValidVideo(incoming(), videoId);
      allow delete: if isValidId(videoId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /usageLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(logId)
        && isVerified()
        && isValidUsageLog(incoming(), logId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if isValidId(logId) && isAdmin();
    }

    match /templates/{templateId} {
      allow get: if isValidId(templateId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(templateId) && isAdmin() && isValidTemplate(incoming(), templateId);
      allow delete: if isValidId(templateId) && isAdmin();
    }
  }
}
